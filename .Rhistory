summary(num_data)
# Select numerical variables
num_data <- sleep_data[, c(
"age",
"bedtime_phone_minutes",
"screen_brightness_pct",
"caffeine_post_5pm_mg",
"physical_activity_min"
)]
# Basic summary statistics
summary(num_data)
# Create a new binary response variable called SleepDebtBinary(Create a new column inside sleep_data called SleepDebtBinary.)
# We want to combine the 4 original sleep debt categories into only 2 groups
sleep_data$SleepDebtBinary <- ifelse(
# Check if the original sleep category is either
# "Moderate Debt" OR "Severe Sleep Debt"
sleep_data$sleep_debt_category %in% c(
"Moderate Debt",
"Severe Sleep Debt"
),
# If the condition above is TRUE, assign 1
1,
# If the condition above is FALSE, assign 0
0
)
# Create a new variable with readable group names
sleep_data$SleepDebtGroup <- ifelse(
# Check if SleepDebtBinary equals 1
sleep_data$SleepDebtBinary == 1,
# If TRUE, label the person as Moderate/Severe
"Moderate/Severe",
# If FALSE, label the person as Mild/Optimal
"Mild/Optimal"
)
# Check the binary groups
table(sleep_data$SleepDebtBinary)
# Check the readable group names
table(sleep_data$SleepDebtGroup)
