#Part C and D
# DATA 474 Midterm Project
# Part C: Classification Models
# Part D: Synthesis and Discussion
# STEP 1: Load and prepare the data
library(class)
set.seed(474)
sleep_data <- read.csv(file.choose())
numeric_vars <- c(
"age",
"bedtime_phone_minutes",
"screen_brightness_pct",
"caffeine_post_5pm_mg",
"physical_activity_min"
)
categorical_vars <- c(
"gender",
"occupation_type",
"chronotype",
"primary_bedtime_app",
"blue_light_filter_active"
)
predictors <- c(numeric_vars, categorical_vars)
# Check the required columns
stopifnot(all(c(predictors, "sleep_debt_category") %in%
names(sleep_data)))
# Create the same binary outcome used in Parts A and B
sleep_data$SleepDebtBinary <- ifelse(
sleep_data$sleep_debt_category %in%
c("Moderate Debt", "Severe Sleep Debt"),
1, 0
)
# Check that the categories are correct
stopifnot(all(sleep_data$sleep_debt_category %in%
c("Moderate Debt", "Severe Sleep Debt",
"Mild Deficit", "Optimal Recovery")))
stopifnot(!anyNA(sleep_data[, predictors]))
for (v in categorical_vars) {
sleep_data[[v]] <- factor(sleep_data[[v]])
}
cat("\nTarget Distribution:\n")
print(table(sleep_data$SleepDebtBinary))
# STEP 2: Prepare five-fold cross-validation
fold_id <- integer(nrow(sleep_data))
for (group in c(0, 1)) {
rows <- sample(which(sleep_data$SleepDebtBinary == group))
fold_id[rows] <- rep(1:5, length.out = length(rows))
}
actual <- sleep_data$SleepDebtBinary
logistic_prob <- numeric(nrow(sleep_data))
knn_prob <- numeric(nrow(sleep_data))
# Convert categorical variables to numerical columns for KNN
knn_data <- model.matrix(
~ . - 1,
data = sleep_data[, predictors, drop = FALSE]
)
# STEP 3: Train Logistic Regression and KNN
for (fold in 1:5) {
train_rows <- which(fold_id != fold)
test_rows <- which(fold_id == fold)
train_data <- sleep_data[train_rows, ]
test_data <- sleep_data[test_rows, ]
# Model 1: Logistic Regression
logistic_model <- glm(
reformulate(predictors, response = "SleepDebtBinary"),
data = train_data,
family = binomial
)
logistic_prob[test_rows] <- predict(
logistic_model,
newdata = test_data,
type = "response"
)
# Model 2: K-Nearest Neighbors
x_train <- knn_data[train_rows, , drop = FALSE]
x_test <- knn_data[test_rows, , drop = FALSE]
# Standardize numerical predictors using training data
means <- colMeans(
x_train[, numeric_vars, drop = FALSE]
)
sds <- apply(
x_train[, numeric_vars, drop = FALSE],
2, sd
)
sds[sds == 0] <- 1
x_train[, numeric_vars] <- scale(
x_train[, numeric_vars],
center = means,
scale = sds
)
x_test[, numeric_vars] <- scale(
x_test[, numeric_vars],
center = means,
scale = sds
)
knn_model <- class::knn(
train = x_train,
test = x_test,
cl = factor(actual[train_rows], levels = c(0, 1)),
k = 15,
prob = TRUE
)
votes <- attr(knn_model, "prob")
knn_prob[test_rows] <- ifelse(
as.character(knn_model) == "1",
votes,
1 - votes
)
cat("Completed fold", fold, "of 5\n")
}
# STEP 4: Calculate evaluation metrics
calculate_auc <- function(actual, probability) {
n1 <- sum(actual == 1)
n0 <- sum(actual == 0)
ranks <- rank(probability)
(sum(ranks[actual == 1]) -
n1 * (n1 + 1) / 2) / (n1 * n0)
}
get_metrics <- function(actual, probability) {
predicted <- ifelse(probability >= 0.5, 1, 0)
TP <- sum(predicted == 1 & actual == 1)
TN <- sum(predicted == 0 & actual == 0)
FP <- sum(predicted == 1 & actual == 0)
FN <- sum(predicted == 0 & actual == 1)
accuracy <- (TP + TN) / length(actual)
precision <- if (TP + FP == 0) NA_real_
else TP / (TP + FP)
recall <- if (TP + FN == 0) NA_real_
else TP / (TP + FN)
auc <- calculate_auc(actual, probability)
c(
Accuracy = accuracy,
Precision = precision,
Recall = recall,
AUC = auc
)
}
logistic_results <- get_metrics(actual, logistic_prob)
knn_results <- get_metrics(actual, knn_prob)
results <- data.frame(
Model = c("Logistic Regression", "KNN"),
rbind(logistic_results, knn_results),
row.names = NULL
)
cat("\n========== PART C: MODEL COMPARISON ==========\n")
print(results, digits = 4, row.names = FALSE)
# STEP 5: Show results for each CV fold
fold_results <- do.call(rbind, lapply(1:5, function(f) {
rbind(
data.frame(
Fold = f,
Model = "Logistic Regression",
t(get_metrics(
actual[fold_id == f],
logistic_prob[fold_id == f]
))
),
data.frame(
Fold = f,
Model = "KNN",
t(get_metrics(
actual[fold_id == f],
knn_prob[fold_id == f]
))
)
)
}))
cat("\n========== CROSS-VALIDATION RESULTS ==========\n")
print(fold_results, digits = 4, row.names = FALSE)
# STEP 6: Confusion matrices
cat("\nLogistic Regression Confusion Matrix:\n")
print(table(
Actual = actual,
Predicted = ifelse(logistic_prob >= 0.5, 1, 0)
))
cat("\nKNN Confusion Matrix:\n")
print(table(
Actual = actual,
Predicted = ifelse(knn_prob >= 0.5, 1, 0)
))
# STEP 7: ROC curves
get_roc <- function(actual, probability) {
index <- order(probability, decreasing = TRUE)
y <- actual[index]
p <- probability[index]
ends <- c(which(diff(p) != 0), length(p))
data.frame(
FPR = c(0, cumsum(y == 0)[ends] / sum(y == 0)),
TPR = c(0, cumsum(y == 1)[ends] / sum(y == 1))
)
}
roc_logistic <- get_roc(actual, logistic_prob)
roc_knn <- get_roc(actual, knn_prob)
draw_roc <- function() {
plot(
roc_logistic$FPR,
roc_logistic$TPR,
type = "l",
col = "blue",
lwd = 2,
xlab = "False Positive Rate",
ylab = "True Positive Rate",
main = "ROC Curves: Logistic Regression vs KNN"
)
lines(
roc_knn$FPR,
roc_knn$TPR,
col = "red",
lwd = 2
)
abline(0, 1, lty = 2)
legend(
"bottomright",
legend = c(
paste("Logistic Regression AUC =",
round(logistic_results["AUC"], 3)),
paste("KNN AUC =",
round(knn_results["AUC"], 3)),
"Random Guess"
),
col = c("blue", "red", "black"),
lty = c(1, 1, 2),
lwd = 2
)
}
# Display the ROC curves
draw_roc()
# Save the ROC figure
png("DATA474_ROC_Curves.png", width = 1000, height = 750)
draw_roc()
dev.off()
cat("\nROC image saved as DATA474_ROC_Curves.png\n")
# STEP 8: Part D - Identify the best model
cat("\n========== PART D: BEST MODEL ==========\n")
best_model <- results$Model[which.max(results$AUC)]
cat("Best model based on AUC:", best_model, "\n")
cat("\nFinal Model Comparison:\n")
print(results, digits = 4, row.names = FALSE)
baseline_accuracy <- max(table(actual)) / length(actual)
cat("\nMajority-Class Baseline Accuracy:\n")
print(round(baseline_accuracy, 4))
# STEP 9: Logistic Regression interpretation
final_logistic <- glm(
reformulate(predictors, response = "SleepDebtBinary"),
data = sleep_data,
family = binomial
)
cat("\n========== LOGISTIC REGRESSION SUMMARY ==========\n")
print(summary(final_logistic))
cat("\n========== ODDS RATIOS ==========\n")
print(round(exp(coef(final_logistic)), 4))
# STEP 10: Save results
write.csv(
results,
"DATA474_Model_Comparison.csv",
row.names = FALSE
)
write.csv(
fold_results,
"DATA474_Cross_Validation.csv",
row.names = FALSE
)
cat("\n========== ANALYSIS COMPLETED ==========\n")
cat("Model comparison, CV results, and ROC figure saved.\n")
